# MongoDB
MONGO_URI=your_mongodb_connection_string

# JWT
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
RESEARCH_MAX_WORKERS=2
# Optional per-agent overrides: GROQ_API_KEY1 through GROQ_API_KEY5

#EXA
EXA_API_KEY=your_exa_api_key

# Document retrieval
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_CHUNK_CHARS=900
DOCUMENT_CHUNK_OVERLAP=140
DOCUMENT_TOP_K=5
DOCUMENT_CONTEXT_CHARS=4500
DOCUMENT_MAX_COSINE_DISTANCE=0.70
